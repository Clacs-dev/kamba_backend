# Copia este ficheiro para .env e preenche com valores reais.

# Base de dados (SQLite por defeito; troca para Postgres quando migrares)
DATABASE_URL=sqlite:///./kamba.db

# Segurança — GERA uma chave aleatoria longa para producao!
# Podes gerar uma com:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-em-producao

DEBUG=True
